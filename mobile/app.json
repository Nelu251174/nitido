{
  "expo": {
    "name": "NITIDO",
    "slug": "nitido-ro",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nitido",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-ios-1024.png",
    "splash": {
      "image": "../public/icons/icon-512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F3EE"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NITIDO folosește camera numai când adaugi dovezi foto pentru o lucrare.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NITIDO accesează fotografiile numai când alegi să le atașezi unei lucrări.",
          "cameraPermission": "NITIDO folosește camera numai când adaugi dovezi foto pentru o lucrare.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NITIDO folosește locația numai pentru lucrarea activă și pentru deschiderea traseului.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#009E60",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon-ios-1024.png",
      "buildNumber": "1",
      "bundleIdentifier": "ro.nitido.app",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false },
      "associatedDomains": []
    },
    "android": {
      "package": "ro.nitido.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundColor": "#F4F3EE"
      },
      "intentFilters": []
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3887c4e7-445a-4954-9d04-7c8adc8519f9"
      }
    },
    "owner": "nitido-ro"
  }
}

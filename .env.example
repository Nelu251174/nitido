# Never commit real credentials. Generate this hash with bcrypt cost 12 or higher.
NITIDO_ADMIN_EMAIL=admin@example.com
NITIDO_ADMIN_PASSWORD_HASH=

# Explicitly opt into local-only conveniences. Bearer auth is for the native app over HTTPS.
NITIDO_SEED_DEMO=false
NITIDO_ENABLE_BEARER_AUTH=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Financial transfers remain disabled until OWNER approves production activation.
NITIDO_STRIPE_CONNECT_TRANSFERS_ENABLED=false
NEXT_PUBLIC_SITE_URL=https://nitido.ro

# Asistent suport AI: este activ numai când ambele valori sunt configurate explicit.
NITIDO_AI_ENABLED=false
OPENAI_API_KEY=
NITIDO_AI_MODEL=gpt-5-mini

# Notificări SMS reale prin Twilio (server-side only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUSH_ENABLED=false
SMS_FALLBACK_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=true
NITIDO_DEEP_LINK_BASE=https://nitido.ro
# Identitatea juridică trebuie completată înainte de publicarea în producție.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_REGISTRATION=
LEGAL_ENTITY_ADDRESS=
LEGAL_CONTACT_EMAIL=

# Email tranzacțional prin Resend (resetare parolă etc.). Fără ele, emailurile nu pleacă.
RESEND_API_KEY=
RESEND_FROM=NITIDO.RO <no-reply@nitido.ro>
